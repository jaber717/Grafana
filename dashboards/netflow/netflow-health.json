      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netflow-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT toStartOfHour(modification_time) AS time, sum(bytes_on_disk) AS bytes FROM system.parts\n     WHERE active AND database = 'default' AND table = 'flows' AND $__timeFilter(modification_time) GROUP BY time ORDER BY time",
          "refId": "A"
