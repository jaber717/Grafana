  "panels": [
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netflow-clickhouse"
      },
      "description": "FLOWING: a flow arrived in the last 5 minutes (exporters → inlet → Kafka → outlet → ClickHouse all working). IDLE: flows exist but none recently — can be an idle lab, not a failure. Container-level state: status.sh.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#C7D0DC",
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "gray",
                  "index": 2,
                  "text": "UNKNOWN"
                },
                "1": {
                  "color": "orange",
                  "index": 1,
                  "text": "IDLE / NO RECENT FLOWS"
                },
                "2": {
                  "color": "green",
                  "index": 0,
                  "text": "FLOWING"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 11,
          "valueSize": 18
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netflow-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT multiIf(age IS NULL, 0, age <= 300, 2, 1) FROM (SELECT min(dateDiff('second', TimeReceived, now())) AS age FROM default.flows WHERE TimeReceived > now() - INTERVAL 24 HOUR AND (('${scope}'='real' AND ExporterAddress != toIPv6('::ffff:247.16.14.11')) OR ('${scope}'='demo' AND ExporterAddress = toIPv6('::ffff:247.16.14.11')) OR '${scope}'='all'))",
          "refId": "A"
        }
      ],
      "title": "PIPELINE",
      "type": "stat"
    },
