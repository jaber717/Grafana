      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netflow-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT table AS Table, sum(bytes_on_disk) AS Size, round(100*sum(bytes_on_disk)/sum(sum(bytes_on_disk)) OVER (), 1) AS Share FROM system.parts\n     WHERE active AND database = 'default' GROUP BY table ORDER BY Size DESC LIMIT 6",
