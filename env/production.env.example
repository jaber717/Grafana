# PRODUCTION environment for grafana-platform on RHEL 9.7.  Copy to /etc/grafana-platform/platform.env (or pass --env-file) and edit.
# NON-SECRET settings only. Secrets live in files under SECRETS_DIR (see docs/PRODUCTION-RHEL97.md), never in this file or in Git.
PLATFORM_ENV=production

# --- Grafana listener -------------------------------------------------------------------------------------------------
GRAFANA_DOMAIN=grafana.example.com
GRAFANA_HTTP_PORT=3000
# https (default) | http. http additionally needs GRAFANA_ALLOW_INSECURE_HTTP=yes
GRAFANA_PROTOCOL=https
GRAFANA_ALLOW_INSECURE_HTTP=no
# PEM certificate (+ intermediates) and private key; copied to /etc/grafana/tls
GRAFANA_TLS_CERT_FILE=/root/tls/grafana.crt
GRAFANA_TLS_KEY_FILE=/root/tls/grafana.key
# PEM CA that signed the certificate above, if it is not already in the system trust store (self-signed: the certificate itself)
GRAFANA_TLS_CA_FILE=
# space-separated sources admitted by firewalld; REQUIRED, there is no default
GRAFANA_ALLOWED_CIDRS=10.0.0.0/24
GRAFANA_ADMIN_USER=admin

# --- Zabbix datasource (uid zabbix-lab is kept: the dashboards reference it) ---------------------------------------------
ZABBIX_DS_NAME=Zabbix
ZABBIX_URL=https://zabbix.example.com/api_jsonrpc.php
ZABBIX_USER=grafana-ro
# PEM CA that signed the Zabbix certificate (installed into the system trust store); empty = system trust only
ZABBIX_CA_FILE=
# keep false in production
ZABBIX_TLS_SKIP_VERIFY=false

# --- ClickHouse datasource (Akvorado) -----------------------------------------------------------------------------------
CLICKHOUSE_HOST=netflow.example.com
CLICKHOUSE_PORT=8443
# TLS to ClickHouse (Akvorado repository: CLICKHOUSE_TLS=yes)
CLICKHOUSE_SECURE=true
CLICKHOUSE_USER=grafana_ro
CLICKHOUSE_CA_FILE=

# --- NOC dashboards: Zabbix item ids differ per Zabbix server -------------------------------------------------------------
# produced by tools/zabbix-item-map.mjs (docs/ZABBIX-ITEM-MAP.md)
ZABBIX_ITEM_MAP_FILE=/etc/grafana-platform/zabbix-item-map.json
# yes = deploy only the 5 NetFlow dashboards when no map exists (reported as WARN)
ALLOW_NOC_WITHOUT_ITEM_MAP=no

# --- Packages -----------------------------------------------------------------------------------------------------------
# repo = official Grafana RPM repository + grafana.com plugin downloads (needs Internet) | bundle = offline bundle
PACKAGE_SOURCE=repo
BUNDLE_DIR=/root/grafana-platform-bundle

# --- Storage / backups ---------------------------------------------------------------------------------------------------
SECRETS_DIR=/etc/grafana-platform/secrets
BACKUP_DIR=/var/backups/grafana-platform
BACKUP_KEEP=8
# if set, backup archives are encrypted (gpg symmetric AES256) with the passphrase in this file
BACKUP_GPG_PASSPHRASE_FILE=
