# grafana-report settings. Copy to /etc/grafana-platform/reports/report.env (mode 0640, root:grafana-report).
# Secrets are NEVER written here: every *_FILE key names a file that holds the secret (mode 0600).
# Validate with:  grafana-report check-config

# ---- Grafana (the reporting platform) ---------------------------------------------------------------------------------------------
GRAFANA_URL=https://grafana.example.com
# Service-account token with the VIEWER role (read dashboards, query the two datasources, render panels). Nothing more.
GRAFANA_TOKEN_FILE=/etc/grafana-platform/reports/grafana.token
# Optional: shown in the e-mail footer
#PUBLIC_GRAFANA_URL=https://grafana.example.com

# ---- What is reported ---------------------------------------------------------------------------------------------------------------
REPORT_KINDS=netflow,interface
INTERFACES_FILE=/etc/grafana-platform/reports/interfaces.yaml

# ---- PDF printing --------------------------------------------------------------------------------------------------------------------
# Chromium for the PDF step. Recommended: the SAME digest-pinned renderer image, run rootless with Podman - no Chromium on the Grafana server.
# {workdir} {uid} {gid} are substituted; the image name must be fully qualified (RHEL refuses short names).
CHROMIUM_CMD=podman run --rm --userns=keep-id --user {uid}:{gid} -v {workdir}:{workdir}:Z -e HOME={workdir} --entrypoint chromium docker.io/grafana/grafana-image-renderer@sha256:4b3d29a66c1dd11d513f8378907953b3c2c0c0535cbf5cf8fe83f7f398ae8b4c
# Alternative with a locally installed Chromium:  CHROMIUM_CMD=/usr/bin/chromium
RENDER_TIMEOUT_SECONDS=90

# ---- Where files and state go ----------------------------------------------------------------------------------------------------
OUTPUT_DIR=/var/lib/grafana-report/out
STATE_DIR=/var/lib/grafana-report/state
LOG_FILE=/var/log/grafana-report/report.log
RETENTION_DAYS=45

# ---- E-mail (OFF until you enable it) -----------------------------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_FROM=NOC Reports <noc-reports@example.com>
# Comma separated, no duplicates. Nothing is sent to anyone not listed here.
EMAIL_TO=noc@example.com
EMAIL_SUBJECT_PREFIX=Daily Network Traffic Reports
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# none | starttls | tls. Credentials are refused over "none".
SMTP_SECURITY=starttls
#SMTP_USER=noc-reports@example.com
#SMTP_PASSWORD_FILE=/etc/grafana-platform/reports/smtp.password
#SMTP_TLS_CA_FILE=/etc/pki/ca-trust/source/anchors/internal-ca.pem

# ---- Telegram (OFF until you enable it) ----------------------------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN_FILE=/etc/grafana-platform/reports/telegram.token
TELEGRAM_CHAT_ID=
#TELEGRAM_API_BASE=https://api.telegram.org

# ---- Retry and failure handling -------------------------------------------------------------------------------------------------------
RETRY_ATTEMPTS=4
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=600
# E-mail a short "generation failed" notice (once per day) when a report cannot be produced
NOTIFY_ON_FAILURE=true
