# Grafana Image Renderer service settings (the host that runs grafana-image-renderer.service). Copy to
# /etc/grafana-platform/reports/renderer.env, mode 0600 root:root.
# Image: digest-pinned and tested (Chromium 154 on Debian 13). Update it only together with a validation run.
RENDERER_IMAGE=docker.io/grafana/grafana-image-renderer@sha256:4b3d29a66c1dd11d513f8378907953b3c2c0c0535cbf5cf8fe83f7f398ae8b4c
# Content-addressed ID of that image. OFFLINE hosts cannot reference the registry digest (a saved archive cannot reproduce a multi-arch manifest
# digest), so `grafana-report load-image` verifies this ID and tags the image localhost/grafana-image-renderer:pinned; then use that name in
# RENDERER_IMAGE and CHROMIUM_CMD instead of the registry reference.
RENDERER_IMAGE_ID=42bb1c2a74afd62274f1469e593e6705ed94d06577a2afd3f74801f9ccfe2bbb
# Same host as Grafana: keep it on loopback.  Separate renderer host: listen on its LAN address (127.0.0.1 would not be reachable) AND
# restrict port 8081 to the Grafana server with firewalld - the token below is the second line of defence.
RENDERER_ADDR=127.0.0.1:8081
# Shared secret. Grafana 13 refuses to start with the default renderer token, so the SAME value goes into grafana.ini [rendering] renderer_token.
# Generate with:  head -c 24 /dev/urandom | base64 | tr -d '/+=' | head -c 32
AUTH_TOKEN=CHANGE-ME-generate-a-random-value
# Measured on RHEL 9.6: ~360 MiB and up to 2.5 CPU cores while rendering a report's panels; limits leave headroom.
RENDERER_MEMORY=2g
RENDERER_CPUS=2
