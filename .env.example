# Environment for the Grafana tooling. Copy to .env OR export in your shell; never commit real values (.env is git-ignored).
# The scripts read the process environment only - source the file yourself:  set -a; . ./.env; set +a
GRAFANA_URL=http://192.168.1.194:3000
# Preferred: a service-account token with Admin role (needed for datasource and folder writes)
#GRAFANA_TOKEN=
# or an admin login
GRAFANA_USER=admin
#GRAFANA_PASSWORD=
# Datasource secrets (only needed when a datasource must be created/updated)
#ZABBIX_GRAFANA_PASSWORD=
#CLICKHOUSE_RO_PASSWORD=
